# Base URL of the NOMAD backend (FastAPI, no /api prefix — routes are
# mounted at the root, e.g. http://localhost:8000/feasibility/).
# Copy this file to .env and fill in the real value once the backend
# and AI decision-engine folders are merged into this repo.
VITE_API_BASE_URL=http://localhost:8000

# Set to "true" while the backend isn't merged in yet — pages use
# built-in mock data shaped exactly like the real response models.
# Flip to "false" once VITE_API_BASE_URL points at a running backend.
VITE_USE_MOCK_DATA=false
