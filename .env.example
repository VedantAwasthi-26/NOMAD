# Existing (Vedant's) settings
MIREYE_API_KEY=your_mireye_api_key_here
MIREYE_BASE_URL=https://api.mireye.example.com

# New -- required for app/engine (the AI/decision layer). Runs on Groq,
# not Anthropic.
GROQ_API_KEY=your_groq_api_key_here

# Optional -- overrides the default Groq model used by app/engine/reasoning.py
# and app/engine/supervisor.py's LLM fallback router. Must be a tool-use-capable
# Groq model (structured output relies on tool calling) -- check
# https://console.groq.com/docs/models for what's currently available.
# NOMAD_ENGINE_MODEL=llama-3.3-70b-versatile

# Optional -- enables LangSmith tracing for the engine's LangGraph runs
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_PROJECT=nomad-engine
